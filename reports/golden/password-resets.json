{
  "feature": "password_resets",
  "captured_at": "2026-07-25T03:20:00Z",
  "capture_method": "live — curl (direct Rails :3001, real token extracted from server-log-delivered mail) + real browser (Playwright driving Angular :4200)",
  "flows": [
    {
      "name": "request reset (curl)",
      "steps": ["POST /api/password_resets {password_reset:{email}}"],
      "expect": { "status": 200, "message": "Email sent with password reset instructions" }
    },
    {
      "name": "check token (curl, real token from mail log)",
      "steps": ["GET /api/password_resets/:token/edit?email=..."],
      "expect": { "status": 200, "email_echoed": true }
    },
    {
      "name": "invalid token rejected as JSON (not an HTML redirect)",
      "steps": ["GET /api/password_resets/bogus-token/edit?email=..."],
      "expect": { "status": 404, "error": "Invalid password reset link" }
    },
    {
      "name": "reset password (curl)",
      "steps": ["PATCH /api/password_resets/:token {email, user:{password, password_confirmation}}"],
      "expect": { "status": 200, "user_returned": true, "session_established": true }
    },
    {
      "name": "old password rejected, new password works",
      "steps": ["POST /api/login with old password", "POST /api/login with new password"],
      "expect": { "old_status": 401, "new_status": 200 }
    },
    {
      "name": "browser: full request->reset->auto-login flow",
      "steps": ["visit /password_resets/new", "submit email", "extract real token from server log", "visit /password_resets/:token/edit?email=...", "submit new password"],
      "expect": { "success_message_shown": true, "navigates_to_profile": true, "header_shows_logged_in_nav": true, "no_console_errors": true }
    }
  ]
}

source 'https://rubygems.org'
git_source(:github) { |repo| "https://github.com/#{repo}.git" }
gem 'rails',                      '6.1.4.6'
# Env-compat: Ruby 3.1's stdlib doesn't auto-require 'logger' early enough for
# Rails 6.1's ActiveSupport to see the Logger constant at load time. Explicit
# dependency forces correct require order (unrelated to app logic).
gem 'logger'
gem 'image_processing',           '1.9.3'
gem 'mini_magick',                '4.9.5'
gem 'active_storage_validations', '0.8.9'
gem 'bcrypt',                     '3.1.13'
gem 'faker',                      '2.11.0'
gem 'will_paginate',              '3.3.0'
gem 'bootstrap-will_paginate',    '1.0.0'
gem 'bootstrap-sass',             '3.4.1'
gem 'puma',                       '5.3.1'
gem 'sass-rails',                 '6.0.0'
gem 'jbuilder',                   '2.10.0'
# Phase 7 (Cutover): Rails is a pure JSON API now, served from a different
# origin than Angular in production, so rack-cors replaces the same-origin
# assumption turbolinks/webpacker used to make.
gem 'rack-cors',                  '1.1.1'
# Bumped from 1.7.2 (env-compat): that version's realpath_cache has a Windows
# path bug (nil into String in dirname) under Ruby 3.1; 1.24.x fixes it.
gem 'bootsnap',                   '~> 1.24', require: false
gem 'factory_bot',                '6.1.0'
gem 'factory_bot_rails',          '6.1.0'
group :development, :test do
  # gem 'debase'
  # gem 'ruby-debug-ide'
  gem 'rspec-rails',        '5.1.2'
  gem 'simplecov',          '0.21.2'
  # Bumped from the pinned 1.4.2 (env-compat fix, not a functional change):
  # 1.4.2's C extension fails to compile under GCC 14 (implicit pointer-type
  # mismatches are hard errors, not warnings, as of GCC 14) and ships no
  # precompiled Windows binary. 1.6.x still satisfies Rails 6.1's `~> 1.4`
  # sqlite3 adapter requirement and ships a precompiled x64-mingw-ucrt gem.
  gem 'sqlite3',            '~> 1.6'
  gem 'byebug',             '11.1.3', platforms: [:mri, :mingw, :x64_mingw]
end
group :development do
  gem 'web-console',        '4.1.0'
  gem 'rack-mini-profiler', '2.3.1'
  gem 'listen',             '3.4.1'
  gem 'spring',             '2.1.1'
end
group :test do
  # Env-compat: 'matrix' and 'rexml' are no longer default stdlib gems as of
  # Ruby ~3.1; capybara and selenium-webdriver still require them transitively.
  gem 'matrix'
  gem 'rexml'
  gem 'capybara',                 '3.35.3'
  gem 'selenium-webdriver',       '3.142.7'
  gem 'webdrivers',               '4.6.0'
  gem 'rails-controller-testing', '1.0.5'
  gem 'minitest',                 '5.11.3'
  gem 'guard',                    '2.16.2'
  gem 'guard-minitest',           '2.4.6'
end
group :production do
  gem 'pg', '1.2.3'
  gem 'aws-sdk-s3', '1.87.0', require: false
end
# Windows does not include zoneinfo files, so bundle the tzinfo-data gem
gem 'tzinfo-data'